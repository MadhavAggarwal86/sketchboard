{"ast":null,"code":"export const getArrowRightHeads=(x1,x2,y1,y2,arrowLength)=>{const angle=Math.atan2(y2-y1,x2-x1);const x3=x2-arrowLength*Math.cos(angle-Math.PI/6);const y3=y2-arrowLength*Math.sin(angle-Math.PI/6);const x4=x2-arrowLength*Math.cos(angle+Math.PI/6);const y4=y2-arrowLength*Math.sin(angle+Math.PI/6);return{x3,y3,x4,y4};};","map":{"version":3,"names":["getArrowRightHeads","x1","x2","y1","y2","arrowLength","angle","Math","atan2","x3","cos","PI","y3","sin","x4","y4"],"sources":["/Users/madhavaggarwal/Desktop/AZ/project-whiteboard/frontend/src/utils/math.js"],"sourcesContent":["export const getArrowRightHeads = (x1, x2, y1, y2, arrowLength) => {\n    const angle = Math.atan2(y2 - y1, x2 - x1);\n    \n    const x3 = x2 - arrowLength * Math.cos(angle - Math.PI/6);\n    const y3 = y2 - arrowLength * Math.sin(angle - Math.PI/6);\n    \n    const x4 = x2 - arrowLength * Math.cos(angle + Math.PI/6);\n    const y4 = y2 - arrowLength * Math.sin(angle + Math.PI/6);\n\n    return { x3, y3, x4, y4 };\n};"],"mappings":"AAAA,MAAO,MAAM,CAAAA,kBAAkB,CAAGA,CAACC,EAAE,CAAEC,EAAE,CAAEC,EAAE,CAAEC,EAAE,CAAEC,WAAW,GAAK,CAC/D,KAAM,CAAAC,KAAK,CAAGC,IAAI,CAACC,KAAK,CAACJ,EAAE,CAAGD,EAAE,CAAED,EAAE,CAAGD,EAAE,CAAC,CAE1C,KAAM,CAAAQ,EAAE,CAAGP,EAAE,CAAGG,WAAW,CAAGE,IAAI,CAACG,GAAG,CAACJ,KAAK,CAAGC,IAAI,CAACI,EAAE,CAAC,CAAC,CAAC,CACzD,KAAM,CAAAC,EAAE,CAAGR,EAAE,CAAGC,WAAW,CAAGE,IAAI,CAACM,GAAG,CAACP,KAAK,CAAGC,IAAI,CAACI,EAAE,CAAC,CAAC,CAAC,CAEzD,KAAM,CAAAG,EAAE,CAAGZ,EAAE,CAAGG,WAAW,CAAGE,IAAI,CAACG,GAAG,CAACJ,KAAK,CAAGC,IAAI,CAACI,EAAE,CAAC,CAAC,CAAC,CACzD,KAAM,CAAAI,EAAE,CAAGX,EAAE,CAAGC,WAAW,CAAGE,IAAI,CAACM,GAAG,CAACP,KAAK,CAAGC,IAAI,CAACI,EAAE,CAAC,CAAC,CAAC,CAEzD,MAAO,CAAEF,EAAE,CAAEG,EAAE,CAAEE,EAAE,CAAEC,EAAG,CAAC,CAC7B,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}